# ==============================================================================
# AIMST UNIVERSITY ONLINE EXAM PROCTORING SYSTEM
# Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these variables in Vercel > Project Settings > Environment Variables for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Credentials (Client-Safe)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ------------------------------------------------------------------------------
# 2. Supabase Server-Only Credentials (CRITICAL: NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Used exclusively inside server actions and route handlers for privileged operations
# Obtain from Supabase Dashboard: Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 3. Application Public URL
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
